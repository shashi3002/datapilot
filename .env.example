# ==============================================================================
# DataPilot Configuration Template
# Copy this file to '.env' and fill in your personal credentials.
# ==============================================================================

# Hugging Face User Access Token (Required for gated datasets like Common Voice or Llama)
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Google Gemini API Key (Required for AI Metric Planning & LLM-as-a-Judge Evaluation)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Storage paths relative to project root
DATAPILOT_DATA_DIR=./data
DATAPILOT_ARTIFACTS_DIR=./artifacts

# Guardrails & Sampling Budgets
DATAPILOT_MAX_DOWNLOAD_GB=5.0
DATAPILOT_DEFAULT_SAMPLE_BUDGET=100
DATAPILOT_MAX_SAMPLE_BUDGET=500
